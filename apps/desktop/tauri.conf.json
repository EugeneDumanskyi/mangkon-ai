{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mangkon AI",
  "version": "0.0.0",
  "identifier": "org.mangkon.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:5173",
        "script-src": "'self' 'unsafe-inline' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "img-src": "'self' data: blob: http://localhost:5173",
        "font-src": "'self' http://localhost:5173",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
