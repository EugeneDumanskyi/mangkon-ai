{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Mangkon's own commands only. No core or plugin permissions (ADR-0003, NFR-SEC-10).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-pick-folder",
    "allow-open-project",
    "allow-close-project",
    "allow-current-project",
    "allow-add-source",
    "allow-progress",
    "allow-connection-count",
    "allow-connections-page",
    "allow-occurrences",
    "allow-source-context",
    "allow-source-document",
    "allow-page-view",
    "allow-page-image",
    "allow-subscribe",
    "allow-record-ui-timing",
    "allow-record-view-sweep"
  ]
}
