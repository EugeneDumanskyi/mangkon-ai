{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Mangkon's own commands only. No core or plugin permissions (ADR-0003, NFR-SEC-10).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-pick-folder",
    "allow-open-project",
    "allow-close-project",
    "allow-current-project",
    "allow-add-source",
    "allow-progress",
    "allow-connection-count",
    "allow-connections-page",
    "allow-occurrences",
    "allow-source-context",
    "allow-source-document",
    "allow-page-view",
    "allow-page-image",
    "allow-open-original",
    "allow-show-in-folder",
    "allow-open-link",
    "allow-pick-files",
    "allow-recent-projects",
    "allow-create-project",
    "allow-locate-project",
    "allow-forget-project",
    "allow-rescan",
    "allow-pause",
    "allow-resume",
    "allow-cancel",
    "allow-documents-page",
    "allow-documents-count",
    "allow-document-types",
    "allow-retry",
    "allow-removal-impact",
    "allow-remove-files",
    "allow-project-settings",
    "allow-save-settings",
    "allow-reprocess",
    "allow-source-roots",
    "allow-relocate-root",
    "allow-remove-root",
    "allow-subscribe",
    "allow-record-ui-timing",
    "allow-record-view-sweep",
    "allow-record-queue-walk"
  ]
}
